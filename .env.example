# ===================================================================
# AASHWIN MART — Environment Configuration Template
# ===================================================================
# Copy this file to .env or set these environment variables in production.
# DO NOT commit real secrets or production credentials to version control.

# Application Environment (development / production / test)
APP_ENV=development
APP_PORT=8080
APP_CONTEXT_PATH=/aashwinmart

# Database Configuration (H2 Database)
# Application runtime mode: File-based persistent storage
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:./data/aashwinmart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE;MODE=LEGACY
DB_USER=sa
DB_PASSWORD=

# HikariCP Pool Configuration
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Security Configuration
SESSION_TIMEOUT_MINUTES=30
BCRYPT_LOG_ROUNDS=12

# AI Chatbot Configuration
# Provider choices: 'mock' (default offline FAQ engine) or 'gemini' (Google Gemini AI API)
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_CHATBOT_TIMEOUT_MS=5000
AI_CHATBOT_RATE_LIMIT_PER_MIN=10
